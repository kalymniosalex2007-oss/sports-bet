<% const a = m.analysis, p = m.prediction, name = `${m.home_name} - ${m.away_name}`, ok = evalPick(p, m);
const dots = r => r.map(x => `<i class="f${x.res}" title="${x.res}">${x.res === 'W' ? 'Ν' : x.res === 'D' ? 'Ι' : 'Η'}</i>`).join('');
const iso = new Date(m.kickoff_ts * 1000).toISOString();
const ld = { '@context': 'https://schema.org', '@type': 'SportsEvent', name, startDate: iso, location: { '@type': 'Place', name: m.venue || m.league_name }, homeTeam: { '@type': 'SportsTeam', name: m.home_name }, awayTeam: { '@type': 'SportsTeam', name: m.away_name } }; %>
<%- include('partials/head', { ld, path: '/predictions/' + m.slug, title: `${name} Προγνωστικά & Ανάλυση ${fmtDay(m.match_date, { day: 'numeric', month: 'long' })} | ${NAME}`,
 desc: p && p.status === 'ok' ? `${name} (${m.league_name}): ανάλυση, απουσίες, στατιστικά και προγνωστικό ${p.label} με εκτιμώμενη πιθανότητα ${p.pct}%.` : `${name} (${m.league_name}): στοιχεία, φόρμα και στατιστικά του αγώνα ${fmtDay(m.match_date)}.` }) %>
<a class="back" href="/?date=<%= m.match_date %>">‹ Όλοι οι αγώνες</a>
<section class="hero"><p class="lg"><img src="<%= m.league_logo %>" alt="" width="20" height="20"><%= m.league_name %> · <%= m.round %></p>
<div class="vs"><div><img src="<%= m.home_logo %>" alt="<%= m.home_name %>" width="72" height="72"><h1><%= m.home_name %></h1></div>
<div class="mid"><% if (m.goals_home !== null) { %><b><%= m.goals_home %> - <%= m.goals_away %></b><% } else { %><b><%= fmtTime(m.kickoff_ts) %></b><% } %><small><%= fmtDay(m.match_date, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></small><small><%= statusLabel(m.status) %></small></div>
<div><img src="<%= m.away_logo %>" alt="<%= m.away_name %>" width="72" height="72"><h1><%= m.away_name %></h1></div></div><% if (m.venue) { %><p class="lg">Γήπεδο: <%= m.venue %></p><% } %></section>
<% if (!a) { %><p class="empty">Η πλήρης ανάλυση αυτού του αγώνα δεν έχει δημιουργηθεί ακόμη. Οι αναλύσεις παράγονται την ημέρα του αγώνα, με προτεραιότητα στα μεγαλύτερα πρωταθλήματα. Δεν εμφανίζουμε στοιχεία που δεν έχουμε από αξιόπιστη πηγή.</p>
<% } else { %>
<section class="panel two"><div><h2>Φόρμα: <%= m.home_name %></h2><div class="form"><%- dots(a.form.home) %></div><ul class="res"><% a.form.home.forEach(r => { %><li><span><%= r.date %> <%= r.home ? 'vs' : '@' %> <%= r.opp %></span><b class="<%= r.res %>"><%= r.gf %>-<%= r.ga %></b></li><% }) %><% if (!a.form.home.length) { %><li>Δεν υπάρχουν διαθέσιμα αποτελέσματα.</li><% } %></ul></div>
<div><h2>Φόρμα: <%= m.away_name %></h2><div class="form"><%- dots(a.form.away) %></div><ul class="res"><% a.form.away.forEach(r => { %><li><span><%= r.date %> <%= r.home ? 'vs' : '@' %> <%= r.opp %></span><b class="<%= r.res %>"><%= r.gf %>-<%= r.ga %></b></li><% }) %><% if (!a.form.away.length) { %><li>Δεν υπάρχουν διαθέσιμα αποτελέσματα.</li><% } %></ul></div></section>
<section class="panel"><h2>Βαθμολογία και κίνητρο</h2><div class="two"><p><%= a.motivation.home %></p><p><%= a.motivation.away %></p></div><p class="note">Το κίνητρο είναι εκτίμηση με βάση τη θέση στη βαθμολογία, όχι επιβεβαιωμένη πληροφορία.</p></section>
<section class="panel"><h2>Στατιστικά εντός και εκτός έδρας (τρέχουσα σεζόν)</h2><div class="scroll"><table><thead><tr><th></th><th>Αγ.</th><th>Ν</th><th>Ι</th><th>Η</th><th>Γκολ</th></tr></thead><tbody>
<% [[m.home_name + ' (εντός)', a.venue.home], [m.away_name + ' (εκτός)', a.venue.away]].forEach(([n, v]) => { %><tr><td><%= n %></td><% if (v) { %><td><%= v.p %></td><td><%= v.w %></td><td><%= v.d %></td><td><%= v.l %></td><td><%= v.gf %>-<%= v.ga %></td><% } else { %><td colspan="5">Δεν διατίθενται δεδομένα</td><% } %></tr><% }) %></tbody></table></div></section>
<section class="panel"><h2>Απουσίες</h2><div class="two"><% [[m.home_name, a.injuries.home], [m.away_name, a.injuries.away]].forEach(([n, l]) => { %><div><h3><%= n %></h3><% if (!a.injuries.has) { %><p class="note">Δεν υπάρχουν διαθέσιμες πληροφορίες.</p><% } else if (!l.length) { %><p class="note">Δεν έχουν καταγραφεί απουσίες στην πηγή (αυτό δεν σημαίνει απαραίτητα ότι δεν υπάρχουν).</p><% } else { %><ul class="list"><% l.forEach(i => { %><li><b><%= i.name %></b> <span><%= i.kind %> · <%= i.status %><%= i.reason ? ' · ' + i.reason : '' %></span></li><% }) %></ul><% } %></div><% }) %></div></section>
<section class="panel"><h2>Ενδεκάδες</h2><% if (m.lineups) { %><p class="note ok">Επίσημες ενδεκάδες, όπως ανακοινώθηκαν.</p><div class="two"><% m.lineups.forEach(t => { %><div><h3><%= t.team_id === m.home_id ? m.home_name : m.away_name %> <small><%= t.formation %></small></h3><ol class="xi"><% t.xi.forEach(x => { %><li><b><%= x.n %></b> <%= x.name %></li><% }) %></ol></div><% }) %></div>
<% } else { %><p class="note">Οι ενδεκάδες δεν έχουν ανακοινωθεί ακόμη και θα εμφανιστούν εδώ μόλις είναι επίσημες (συνήθως 20-60' πριν την έναρξη). Δεν δημοσιεύουμε εκτιμώμενες ενδεκάδες χωρίς αξιόπιστη πηγή.</p><% } %></section>
<section class="panel"><h2>Head to Head</h2><% if (a.h2h.list.length) { %><p><b><%= a.h2h.hw %></b> νίκες <%= m.home_name %> · <b><%= a.h2h.d %></b> ισοπαλίες · <b><%= a.h2h.aw %></b> νίκες <%= m.away_name %> · μ.ό. <%= a.h2h.avg %> γκολ</p><ul class="res"><% a.h2h.list.forEach(x => { %><li><span><%= x.date %> · <%= x.home %> - <%= x.away %></span><b><%= x.gh %>-<%= x.ga %></b></li><% }) %></ul><% } else { %><p class="note">Δεν υπάρχει ιστορικό αναμετρήσεων στην πηγή δεδομένων.</p><% } %></section>
<section class="panel"><h2>Σημαντικές πληροφορίες</h2><ul class="list"><% a.notes.forEach(n => { %><li><%= n %></li><% }) %></ul></section>
<% } %>
<% if (a && a.ai && a.ai.text) { %><section class="panel ai"><h2>Ανάλυση αγώνα <small><%= a.ai.edited ? '(επιμέλεια συντάκτη)' : '(δημιουργήθηκε αυτόματα με AI)' %></small></h2><% a.ai.text.split(/\n\s*\n/).forEach(t => { %><p><%= t %></p><% }) %><p class="note">Το κείμενο βασίζεται αποκλειστικά στα δεδομένα των ενοτήτων παραπάνω και μπορεί να περιέχει λάθη. Έλεγξε τις επίσημες ανακοινώσεις των ομάδων.</p></section><% } %>
<section class="pred"><h2>Προγνωστικό</h2>
<% if (p && p.status === 'ok') { %><div class="big"><span class="pl">Επιλογή</span><strong><%= p.label %></strong></div>
<dl><div><dt>Αγορά</dt><dd><%= p.market %></dd></div><div><dt>Εκτίμηση πιθανότητας</dt><dd><%= p.pct %>%</dd></div><div><dt>Επίπεδο εμπιστοσύνης</dt><dd><%= p.confidence %></dd></div></dl>
<h3>Αιτιολόγηση</h3><ul class="list"><% p.reasons.forEach(r => { %><li><%= r %></li><% }) %></ul>
<p class="alts">Αγορές που εξετάστηκαν: <% p.alts.forEach(x => { %><span><%= x.label %> <%= x.pct %>%</span><% }) %></p>
<% if (ok !== null) { %><p class="result <%= ok ? 'win' : 'loss' %>">Αποτέλεσμα προγνωστικού: <%= ok ? 'επιτυχία' : 'αποτυχία' %></p><% } %>
<% } else { %><p><%= p ? p.note : 'Δεν υπάρχουν επαρκή δεδομένα για προγνωστικό σε αυτόν τον αγώνα.' %></p><% } %>
<% if (p && p.source === 'manual') { %><p class="note">Επιλογή συντάκτη: η πιθανότητα είναι εκτίμηση της συντακτικής ομάδας.</p><% } else { %><p class="note">Η πιθανότητα είναι εκτίμηση στατιστικού μοντέλου.</p><% } %><p class="note">Δεν αποτελεί εγγύηση. Δεν προτείνουμε ποσά στοιχηματισμού. 18+, παίξτε υπεύθυνα.</p></section>
<%- include('partials/foot') %>
